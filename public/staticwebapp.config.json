{
    "navigationFallback": {
       "rewrite": "index.html",
       "exclude": ["/static/media/*.{png,jpg,jpeg,gif,bmp}",   "/static/css/*"]
    },
    "mimeTypes": {
        ".json": "text/json"
    },
    "routes": [
        {
            "route": "/data-api/*",
            "allowedRoles": ["anonymous"],
            "rewrite": "https://dab-container-app.azurestaticapps.net/data-api/*"
        }
    ]
}